# Modèle de configuration de l'agent.
# Sur Render, ces valeurs se saisissent dans l'onglet « Environment » du service.
# Ne mettez JAMAIS les vraies valeurs dans ce fichier ni dans GitHub.

# ---------- Obligatoires ----------

# Clé de l'API Claude (platform.claude.com > Settings > API keys). Commence par sk-ant-
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Token permanent de l'utilisateur système Meta (Paramètres de l'entreprise > Utilisateurs système)
WHATSAPP_TOKEN=EAAxxxxxxxx

# Identifiant du numéro WhatsApp (application Meta > WhatsApp > API Setup > Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Phrase secrète que vous inventez, à recopier à l'identique dans WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=mali-agent-2026-k7

# Clé secrète de l'application Meta (App settings > Basic > App secret)
WHATSAPP_APP_SECRET=0123456789abcdef0123456789abcdef

# Mot de passe de la page /admin (utilisateur : admin). 16 caractères ou plus.
ADMIN_PASSWORD=changez-moi-avec-un-long-mot-de-passe

# ---------- Facultatives ----------

# Modèle Claude : claude-opus-5-5 (défaut), claude-sonnet-5-5 ou claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Identifiant du compte WhatsApp Business (nécessaire pour le bouton « Abonner l'application »)
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345

# Version de l'API Graph de Meta
GRAPH_API_VERSION=v26.0

# Numéro qui reçoit les alertes (commandes, demandes d'humain), chiffres seulement, avec l'indicatif
OWNER_WHATSAPP=22375758670

# Dossier où l'agent enregistre conversations et commandes (sur Render avec disque : /var/data)
DATA_DIR=./data

# Fuseau horaire utilisé pour dater les messages (défaut : Africa/Bamako)
FUSEAU_HORAIRE=Africa/Bamako

# Port d'écoute (Render le fournit automatiquement)
# PORT=3000
